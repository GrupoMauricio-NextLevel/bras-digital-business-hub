#!/bin/bash
# Antes de cada commit: tipos e estilo. Rápido (cerca de 30 s). Para pular em emergência: git commit --no-verify (não recomendado).
cd "$(git rev-parse --show-toplevel)" || exit 1
echo "▶ verificando tipos…"
npx tsc --noEmit || { echo "✖ Erro de tipos: corrija antes de commitar."; exit 1; }
FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|tsx|mjs)$' | grep -E '^(src|e2e|tests)/')
if [ -n "$FILES" ]; then
  echo "▶ verificando estilo…"
  echo "$FILES" | xargs npx eslint --max-warnings=0 || { echo "✖ Erro de estilo: corrija antes de commitar."; exit 1; }
fi
exit 0
