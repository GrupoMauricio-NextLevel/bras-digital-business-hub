{
  "name": "nextlevel-commerce-engine",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/gerar-novidades.mjs",
    "build": "next build",
    "start": "next start -p ${PORT:-3000}",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:rapido": "vitest run --changed origin/claude/wonderful-cannon-5o38v5",
    "conferir:producao": "node e2e/conferencia-producao.mjs",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "SEED_DEMO=true tsx scripts/bootstrap.ts",
    "db:reset": "rm -rf data/pg && npm run db:migrate && npm run db:seed",
    "db:bootstrap": "tsx scripts/bootstrap.ts",
    "start:prod": "npm run db:bootstrap && next start -p ${PORT:-3000}",
    "e2e": "bash e2e/run.sh",
    "verificar": "tsc --noEmit && eslint src e2e tests --max-warnings=0 && vitest run",
    "verificar:rapido": "tsc --noEmit && eslint src e2e tests --max-warnings=0",
    "ganchos": "bash scripts/instalar-ganchos.sh"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@types/qrcode": "^1.5.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.2",
    "lucide-react": "^1.70.0",
    "next": "^16.4.6",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axe-core": "^4.14.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "playwright-core": "^1.65.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
