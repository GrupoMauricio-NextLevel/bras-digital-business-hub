# NextLevel Commerce Engine — ambiente próprio (não compartilhar com outros projetos)

# Local / Docker (PGlite: Postgres embutido, arquivo em ./data/pg — nada a instalar)
DATABASE_URL=pglite://./data/pg

# Produção (Netlify DB / Neon / qualquer Postgres). Na Netlify, NETLIFY_DATABASE_URL é injetada automaticamente.
# DATABASE_URL=postgres://user:senha@host/db?sslmode=require

# Habilita login sem senha e o Demo Role Switcher
NEXT_PUBLIC_DEMO_MODE=true
