# NextLevel Commerce Engine — ambiente próprio (não compartilhar com outros projetos)

# --- Banco ---------------------------------------------------------------
# Local / Docker: PGlite (Postgres embutido em ./data/pg, nada a instalar)
DATABASE_URL=pglite://./data/pg
# Produção: qualquer Postgres. Na Netlify, NETLIFY_DATABASE_URL é injetada pela extensão Neon.
# DATABASE_URL=postgres://user:senha@host/db?sslmode=require

# --- Segurança (OBRIGATÓRIO em produção) ---------------------------------
# Assina cookies de sessão e criptografa tokens do Mercado Pago. Gere com: openssl rand -hex 32
SESSION_SECRET=troque-por-um-valor-longo-e-aleatorio
# Protege o endpoint de expiração de reservas: GET /api/cron/expire-reservations (Authorization: Bearer <valor>)
CRON_SECRET=

# --- URL pública (webhook e retorno do Mercado Pago) ---------------------
# Deve ser https em produção. Na Netlify/Vercel é detectada automaticamente.
# APP_URL=https://sua-plataforma.com

# --- Primeiro acesso em produção -----------------------------------------
# Cria o usuário master no bootstrap (mín. 10 caracteres na senha)
# MASTER_EMAIL=voce@nextlevel.com
# MASTER_PASSWORD=
# Dados de demonstração (só desenvolvimento/apresentação; nunca em produção real)
# SEED_DEMO=true

# --- Demo mode -----------------------------------------------------------
# true = login com um clique e seletor de perfis. Em produção deixe false.
NEXT_PUBLIC_DEMO_MODE=true
