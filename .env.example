# NextLevel Commerce Engine — modelo de variáveis de ambiente.
# Copie para .env.local (desenvolvimento) ou cadastre como variáveis/segredos na hospedagem.
# Este arquivo contém SOMENTE nomes; nunca coloque valores reais aqui.

# --- Banco -----------------------------------------------------------------
# Vazio = PGlite local em ./data/pg. `pglite://memory` = banco em memória (demonstração).
# Produção: postgres://usuario:senha@host:5432/banco
DATABASE_URL=
# Alternativa injetada pela Netlify (extensão Neon); usada se DATABASE_URL estiver vazia.
NETLIFY_DATABASE_URL=

# --- Segurança (OBRIGATÓRIO em produção) -----------------------------------
# Assina cookies de sessão e criptografa tokens do Mercado Pago (gere com: openssl rand -hex 32).
SESSION_SECRET=
# Protege os endpoints de cron (Authorization: Bearer <valor>).
CRON_SECRET=

# --- URL pública -----------------------------------------------------------
# Usada em webhooks e retorno do checkout. Deve ser https em produção.
APP_URL=
# Domínio raiz das lojas em subdomínio (ex.: superdrop.com.br). Vazio = /store/[slug].
SUPERDROP_ROOT_DOMAIN=

# --- Primeiro acesso (produção) --------------------------------------------
MASTER_EMAIL=
MASTER_PASSWORD=
MASTER_NAME=

# --- Demonstração ----------------------------------------------------------
# true = mostra perfis de demonstração e Pix/Mercado Pago SIMULADOS. Lido no BUILD (NEXT_PUBLIC_).
NEXT_PUBLIC_DEMO_MODE=
# true = popula dados fictícios ao subir com banco vazio (bootstrap).
SEED_DEMO=
# true = migra e popula o banco automaticamente na primeira requisição (útil com pglite://memory).
DEMO_AUTOSEED=

# --- Mercado Pago ----------------------------------------------------------
# As credenciais NÃO ficam em variáveis: cada tenant cola o Access Token no painel e ele é
# guardado criptografado no banco (loja, fornecedor e conta da NextLevel).
# Só para testes ponta a ponta com o servidor simulado (e2e/fake-mp.mjs):
MERCADOPAGO_API_URL=

# --- Reservados para os próximos módulos (ainda não usados pelo código) ------
# E-mail transacional
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=
# Armazenamento de arquivos (hoje as etiquetas PDF ficam no banco; futuro: Cloudflare R2 ou S3)
STORAGE_PROVIDER=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_ENDPOINT=
# Cloudflare (futuro: D1/R2/Hyperdrive)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_R2_BUCKET=
HYPERDRIVE_CONNECTION_STRING=
NEXT_PUBLIC_SITE_URL=https://superdrop.com.br
